{
  "name": "notes-plus",
  "productName": "Notes+",
  "version": "1.2.0",
  "description": "A Windows 11 Notepad clone",
  "main": "electron/main.cjs",
  "author": "amadeusk1",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5174 && node scripts/run-electron.cjs\"",
    "build": "vite build",
    "start": "node scripts/run-electron.cjs",
    "pack": "vite build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.amadeusk1.notesplus",
    "productName": "Notes+",
    "copyright": "Copyright © amadeusk1",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/assets/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "src/assets/icon.png",
      "executableName": "NotesPlus",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "NotesPlus-${version}-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Notes+",
      "uninstallDisplayName": "Notes+"
    }
  },
  "dependencies": {
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "iconv-lite": "^0.6.3",
    "markdown-it": "^14.1.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^37.2.6",
    "electron-builder": "^26.15.3",
    "vite": "^7.0.6",
    "wait-on": "^8.0.4"
  }
}
